# Осы файлды .env деп көшіріп, толтырыңыз. .env файлын ешкімге жібермеңіз.

# @BotFather берген токен
BOT_TOKEN=

# Сіздің Telegram ID. Рұқсатты тек осы адам береді.
ADMIN_TELEGRAM_ID=

# Сервердің https мекенжайы, соңында / жоқ
PUBLIC_URL=https://stock.example.kz

# Міндетті емес. Әрқашан рұқсаты болатын ID-лер: 111,222
ALLOWED_TELEGRAM_IDS=

# 1С
ONEC_ODATA_URL=https://1c.example.kz/BaseName/odata/standard.odata
ONEC_USER=
ONEC_PASSWORD=

# Төмендегі атаулар жұмыс базасында тексерілген.
# Өзгертудің қажеті жоқ, олар тек анықтама үшін тұр.
# ONEC_STOCK_REGISTER=ТоварыНаСкладах
# ONEC_QUANTITY_FIELD=ВНаличииBalance
# ONEC_RESERVE_FIELD=
# ONEC_ITEM_DIMENSION=Номенклатура_Key
# ONEC_WAREHOUSE_DIMENSION=Склад_Key
# ONEC_ITEM_CATALOG=Номенклатура
# ONEC_ARTICLE_FIELD=Артикул
# ONEC_UNIT_FIELD=ЕдиницаИзмерения____Presentation
# ONEC_WAREHOUSE_CATALOG=Склады
