# @BotFather берген токен (міндетті)
BOT_TOKEN=

# Бот иесінің Telegram ID-і (бірнешеу болса үтірмен).
ADMIN_IDS=

# ADMIN_IDS бос болса: иесі болуға арналған құпия код (https://t.me/<бот>?start=<КОД>).
# Бұл да бос болса, ботқа бірінші /start жазған адам иесі болады.
OWNER_CODE=

# Журнал сақталатын папка
DATA_DIR=data
